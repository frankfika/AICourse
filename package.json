{
  "name": "ai-academy",
  "version": "1.5.6",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "AI Academy - AI and LLM education platform",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @ai-academy/web dev",
    "dev:api": "pnpm --filter @ai-academy/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @ai-academy/web build",
    "build:api": "pnpm --filter @ai-academy/api build",
    "start": "pnpm --filter @ai-academy/api start",
    "lint": "pnpm -r lint",
    "check": "pnpm lint && pnpm test && pnpm build",
    "check:go": "cd apps/api-go && make lint && go build ./... && go test $(go list ./... | grep -v '/test/e2e')",
    "check:full": "pnpm check && pnpm e2e && pnpm e2e:real && pnpm check:go",
    "test": "node --test deploy/*.test.mjs && pnpm -r test",
    "e2e": "pnpm --filter @ai-academy/web e2e",
    "e2e:real": "node scripts/e2e-real-flow.mjs",
    "deploy:generate-env": "node deploy/generate-production-env.mjs",
    "deploy:validate": "node deploy/validate-production-env.mjs",
    "db:generate": "pnpm --filter @ai-academy/api db:generate",
    "db:migrate": "pnpm --filter @ai-academy/api db:migrate",
    "db:studio": "pnpm --filter @ai-academy/api db:studio",
    "db:seed": "pnpm --filter @ai-academy/api db:seed",
    "db:seed:demo": "pnpm --filter @ai-academy/api db:seed:demo",
    "setup:demo": "bash scripts/setup-demo.sh"
  },
  "devDependencies": {
    "@prisma/client": "6.2.0",
    "@types/node": "^22.14.0",
    "prisma": "6.2.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
