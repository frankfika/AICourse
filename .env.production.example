# Copy to .env.production on the server and replace every generated value.
# Generate secrets with: openssl rand -hex 32

PUBLIC_URL=https://academy.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

MYSQL_ROOT_PASSWORD=replace-with-64-random-hex
MYSQL_DATABASE=ai_academy
MYSQL_USER=ai_academy
MYSQL_PASSWORD=replace-with-url-safe-random-value
DATABASE_URL=mysql://ai_academy:replace-with-url-safe-random-value@mysql:3306/ai_academy

REDIS_PASSWORD=replace-with-64-random-hex

MINIO_ROOT_USER=aiacademy
MINIO_ROOT_PASSWORD=replace-with-64-random-hex
MINIO_BUCKET=ai-academy
# Same public host as PUBLIC_URL. Nginx proxies /ai-academy/* to MinIO.
STORAGE_PUBLIC_HOST=academy.example.com
STORAGE_PUBLIC_PORT=443
STORAGE_PUBLIC_SSL=true

JWT_SECRET=replace-with-64-random-hex
AI_KEY_ENCRYPTION_KEY=replace-with-64-random-hex

BOOTSTRAP_DATA=true
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=replace-with-a-strong-initial-password

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ENTERPRISE_NOTIFY_EMAIL=
RESEND_API_KEY=
MAIL_FROM=

# Keep email_password enabled. Add oauth.google and/or oauth.github only after
# registering the exact public callback URL with the provider.
AUTH_PROVIDERS=email_password
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URI=
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_REDIRECT_URI=
